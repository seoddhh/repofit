{
  "type": "object",
  "properties": {
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480
    },
    "patterns": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^pattern-[0-9]+$"
          },
          "observation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 480
          },
          "interpretation": {
            "type": "string",
            "minLength": 1,
            "maxLength": 480
          },
          "need": {
            "type": "string",
            "minLength": 1,
            "maxLength": 480
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "sourceIds": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^case-(?:[1-9]|10)-item-[0-9]+$"
            },
            "minItems": 1,
            "maxItems": 6
          },
          "assessment": {
            "type": "object",
            "properties": {
              "criterion": {
                "type": "string",
                "enum": [
                  "goal_context",
                  "continuity",
                  "scope",
                  "verification",
                  "reuse"
                ]
              },
              "status": {
                "type": "string",
                "enum": [
                  "confirmed_issue",
                  "opportunity",
                  "insufficient_evidence",
                  "working_well",
                  "not_applicable"
                ]
              },
              "attribution": {
                "type": "string",
                "enum": [
                  "user",
                  "agent",
                  "environment",
                  "shared",
                  "unknown"
                ]
              },
              "cause": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "impact": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "alternativeExplanation": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "nextCheck": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240
              },
              "evidence": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "properties": {
                    "sourceId": {
                      "type": "string",
                      "pattern": "^case-(?:[1-9]|10)-item-[0-9]+$"
                    },
                    "kind": {
                      "type": "string",
                      "enum": [
                        "user_request",
                        "agent_response",
                        "command",
                        "tool"
                      ]
                    },
                    "summary": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 160
                    }
                  },
                  "required": [
                    "sourceId",
                    "kind",
                    "summary"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "criterion",
              "status",
              "attribution",
              "cause",
              "impact",
              "alternativeExplanation",
              "nextCheck",
              "evidence"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "id",
          "observation",
          "interpretation",
          "need",
          "query",
          "sourceIds",
          "assessment"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5
    },
    "strengths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 480
      },
      "minItems": 0,
      "maxItems": 3
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 480
      },
      "minItems": 1,
      "maxItems": 5
    },
    "rubricVersion": {
      "type": "string",
      "const": "workflow-evidence-v1"
    }
  },
  "required": [
    "rubricVersion",
    "summary",
    "patterns",
    "strengths",
    "limitations"
  ],
  "additionalProperties": false
}
